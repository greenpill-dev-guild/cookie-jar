{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["DOM", "DOM.Iterable", "ES2022"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"noEmit": true,
		"types": ["vite/client", "vitest/globals"],
		"paths": {
			"@/*": ["./src/*"],
			"@jar-core/*": ["../shared/src/*"]
		}
	},
	"include": ["src", "vite.config.ts", "vitest.config.ts"]
}
